# Copy this file to .env.local and fill your real keys.
# Do NOT commit .env.local to Git.

# Optional: deepseek | gemini
# If you are in mainland China/Hong Kong and cannot access OpenRouter/Google reliably,
# prefer deepseek and optionally disable remote TTS below.
VITE_AI_PROVIDER=gemini

VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=google/gemini-2.5-flash
VITE_GEMINI_ENDPOINT=https://openrouter.ai/api/v1
VITE_OPENROUTER_API_KEY=
VITE_CHARACTER_IMAGE_MODEL=google/gemini-3.1-flash-image-preview
VITE_CHARACTER_IMAGE_ENDPOINT=https://openrouter.ai/api/v1

# Optional DeepSeek route (often easier without VPN in CN regions)
VITE_DEEPSEEK_API_KEY=
VITE_DEEPSEEK_MODEL=deepseek-chat
VITE_DEEPSEEK_ENDPOINT=https://api.deepseek.com

# Optional: Remote TTS via OpenRouter / OpenAI-compatible audio models
# When VITE_TTS_STRICT_TEXT_SYNC=1, audio is played only if returned transcript
# matches the on-screen text; otherwise it is dropped silently.
VITE_ENABLE_REMOTE_TTS=1
VITE_REMOTE_TTS_API_KEY=
VITE_TTS_STRICT_TEXT_SYNC=1
VITE_TTS_DEBUG=1
VITE_REMOTE_TTS_ENDPOINT=https://openrouter.ai/api/v1
VITE_REMOTE_TTS_MODEL=openai/gpt-audio-mini
VITE_REMOTE_TTS_VOICE=alloy
VITE_REMOTE_TTS_FORMAT=pcm16
